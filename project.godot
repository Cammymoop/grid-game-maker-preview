; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Grid Game Maker"
config/description="A powerful almost-all-in-one tool for quickly making all sorts of grid-based games."
config/version="preview"
run/main_scene="res://Scenes/Loading.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.png"

[autoload]

Utility="*res://src/Singletons/utility.gd"
EntityManager="*res://src/Singletons/entity_manager.gd"
MapManager="*res://src/Singletons/map_manager.gd"
GameManager="*res://src/Singletons/GameManager.tscn"
TextureManager="*res://src/Singletons/texture_manager.gd"
ConditionalFunctions="*res://src/Singletons/conditional_functions.gd"
FilesManager="*res://src/Singletons/files_manager.gd"
InputTemplates="*res://src/Singletons/input_templates.gd"
Commands="*res://src/Singletons/commands.gd"
ConditionalsV3="*uid://bp02fk3ur8qi5"
ConditionalsV2="*res://src/Singletons/conditionals_v2.gd"
OldConditionalConverter="*res://src/Singletons/old_conditional_converter.gd"
UiUtil="*uid://bk2amu7jaulpw"
Autocomplete="*uid://ucb851a8s6xk"
GlobalToaster="*uid://dyjhlku4kgqkm"
EffectsHelper="*uid://kxi1ld2dix41"
ArchiveCopier="*uid://bexxadydwdpsw"
ImportZipExtractor="*uid://bg40rb011v4ol"
ImporterExporter="*uid://cff2g1aawe1xa"

[debug]

gdscript/warnings/return_value_discarded=false
gdscript/warnings/narrowing_conversion=false
gdscript/warnings/treat_warnings_as_errors=true

[display]

window/size/viewport_width=768
window/size/viewport_height=768
window/size/initial_position_type=4
window/size/window_width_override=768
window/size/window_height_override=768
window/stretch/scale=2.0

[global_group]

TextBox="the multipurpose textbox"

[gui]

theme/custom="res://src/UI/DefaultProjectTheme.tres"

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": true,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

